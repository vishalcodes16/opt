<UserControl x:Class="VishalXOpt.UI.Controls.SystemCore3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True">
    <Border CornerRadius="16" BorderBrush="#365B93" BorderThickness="1" Background="#0A1124">
        <Grid ClipToBounds="True">
            <Viewport3D x:Name="View">
                <Viewport3D.Camera>
                    <PerspectiveCamera Position="0,0,7" LookDirection="0,0,-7" FieldOfView="42" />
                </Viewport3D.Camera>
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <AmbientLight Color="#24385C" />
                    </ModelVisual3D.Content>
                </ModelVisual3D>
                <ModelVisual3D x:Name="CoreModel" />
            </Viewport3D>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="8,4" Background="#B20A1124" CornerRadius="7">
                <TextBlock Text="LIVE PERFORMANCE CORE" FontSize="10" FontWeight="SemiBold" Foreground="#82C7FF" />
            </Border>
            <TextBlock Text="MEASURE • TUNE • VERIFY" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="10" Foreground="#80BFFF" Margin="0,0,0,10" />
        </Grid>
    </Border>
</UserControl>
