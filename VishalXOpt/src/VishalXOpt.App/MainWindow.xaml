<Window x:Class="VishalXOpt.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Vishal X Opt" Width="1500" Height="900" MinWidth="1180" MinHeight="720" Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#090F21" BorderBrush="#162749" BorderThickness="0,0,1,0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="18"><TextBlock Text="VISHAL" FontSize="25" FontWeight="Bold"/><TextBlock Text="X OPT" FontSize="25" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/><TextBlock Text="SYSTEM OPTIMIZATION SUITE" FontSize="9" Opacity=".55" Margin="0,4,0,12"/><Button Content="☰  Collapse" Command="{Binding ToggleSidebarCommand}"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Pages}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border><Grid Grid.Column="1" Margin="25"><Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="{Binding SelectedPage}" FontSize="30" FontWeight="Bold"/><TextBlock Text="Detect  →  Backup  →  Preview  →  Optimize  →  Verify  →  Measure  →  Undo" FontSize="11" Opacity=".58"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBox x:Name="SearchBox" Width="220" Height="34" Margin="4" VerticalContentAlignment="Center" ToolTip="Search modules, MSI, HAGS, Game Mode, Cleanup, Wi-Fi..."/><TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="0,0,14,0" Opacity=".65"/><Border Background="#101A31" CornerRadius="12" Padding="12"><TextBlock Text="●  SAFE MODE" Foreground="#79D7A6"/></Border><Button Content="Scan System" Command="{Binding ScanCommand}"/></StackPanel></DockPanel><ContentControl x:Name="PageHost" Grid.Row="1"/></Grid></Grid></Window>